{
  "manifest_version": 3,
  "name": "Fuck Facebook",
  "version": "1.6",
  "description": "Conditions you not to open Facebook by insulting you instead.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://facebook.com/*",
    "*://*.fb.com/*",
    "*://fb.com/*",
    "*://*.messenger.com/*",
    "*://messenger.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "settings.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "*://*.fb.com/*",
        "*://fb.com/*",
        "*://*.messenger.com/*",
        "*://messenger.com/*"
      ],
      "js": [
        "settings.js",
        "timer-debug.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fuckfacebook@fadyanwar.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
