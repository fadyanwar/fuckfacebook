{
  "manifest_version": 3,
  "name": "Fuck Facebook",
  "version": "1.7",
  "description": "Conditions you not to open Facebook by insulting you instead.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://facebook.com/*",
    "*://*.fb.com/*",
    "*://fb.com/*",
    "*://*.messenger.com/*",
    "*://messenger.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "*://*.fb.com/*",
        "*://fb.com/*",
        "*://*.messenger.com/*",
        "*://messenger.com/*"
      ],
      "js": [
        "ext.js",
        "settings.js",
        "timer-debug.js"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
